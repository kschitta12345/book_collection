<!DOCTYPE html>
<html>
  <head>
    <title>Directory</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <% flash.each do |type, message| %>
      <div class="flash <%= type %>" style="background:#fee; color:#900; padding:8px; margin:8px 0; border:1px solid #f99;">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
