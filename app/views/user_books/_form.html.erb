<%= form_with(model: user_book) do |form| %>
  <% if user_book.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(user_book.errors.count, "error") %> prohibited this user_book from being saved:</h2>
      <ul>
        <% user_book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id %><br>
    <%= form.select :user_id, User.order(:username).map { |u| [u.username, u.id] },
          include_blank: true, id: "id_of_the_user_id_select_box" %>
  </div>

  <div>
    <%= form.label :book_id %><br>
    <%= form.select :book_id, Book.order(:title).map { |b| [b.title, b.id] },
          include_blank: true, id: "id_of_the_book_id_select_box" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
